{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "name": "AI-Powered Resume Creation Suite",
  "version": "1.1.0",
  "description": "Enterprise cross-platform resume builder application architecture supporting Web, Mobile (Android/iOS), REST Backend Server, DB-Driven Auth (Phone+Password & Phone/Email OTP), User Management Suite, and System Configuration Dashboard.",
  "repository": "https://github.com/Sarbajit12345/Mobile-Application-for-the-Resume-Creation-.git",
  "system_architecture": {
    "monorepo_structure": {
      "root": "/",
      "web_application": "/web",
      "mobile_application": "/mobile",
      "backend_server": "/server"
    },
    "tech_stack": {
      "web": {
        "framework": "React 18 / Vite",
        "styling": "Vanilla CSS Design System (Custom Tokens, CSS Variables, Glassmorphism)",
        "icons": "Lucide React",
        "authentication": "Dual Mode (Phone/Email + Password & Phone/Email + OTP)",
        "pdf_generation": "HTML5 Canvas & Client-side PDF Engine",
        "state_management": "React Context / Hooks with Local Storage Synchronization"
      },
      "mobile": {
        "framework": "React / Cross-Platform Mobile Touch Engine",
        "ui_paradigm": "Swipeable Wizard Tabs, Touch Auth Drawers & Action Sheets",
        "pdf_export": "Mobile Native PDF Saver",
        "offline_support": "Local Storage Sync"
      },
      "server": {
        "runtime": "Node.js (v18+ / v20+)",
        "framework": "Express.js REST API",
        "orm_database_ready": "Prisma ORM (PostgreSQL, MongoDB, or SQLite)",
        "security": "Passcode Hash, Email/Phone Verification Tokens, Security Audit Logging"
      }
    }
  },
  "database_schema": {
    "engine_support": ["PostgreSQL", "MongoDB", "SQLite"],
    "orm": "Prisma",
    "entities": {
      "User": {
        "id": "String (UUID/ObjectId)",
        "fullName": "String",
        "email": "String (Unique)",
        "phone": "String (Unique)",
        "passwordHash": "String",
        "isEmailVerified": "Boolean",
        "isPhoneVerified": "Boolean",
        "role": "Enum(ADMIN, USER)",
        "lastLoginAt": "DateTime",
        "createdAt": "DateTime",
        "updatedAt": "DateTime"
      },
      "AuthConfig": {
        "id": "String (Primary Key)",
        "requireEmailVerification": "Boolean",
        "requirePhoneOtp": "Boolean",
        "allowPasswordAuth": "Boolean",
        "allowOtpAuth": "Boolean",
        "otpExpirySeconds": "Int",
        "maxOtpAttempts": "Int",
        "sessionDurationHours": "Int",
        "updatedAt": "DateTime"
      },
      "VerificationToken": {
        "id": "String",
        "target": "String (Email or Phone)",
        "code": "String (6-digit PIN)",
        "type": "Enum(EMAIL_VERIFY, PHONE_OTP)",
        "expiresAt": "DateTime",
        "used": "Boolean"
      },
      "SecurityLog": {
        "id": "String",
        "userId": "String",
        "action": "String",
        "ipAddress": "String",
        "createdAt": "DateTime"
      },
      "Resume": {
        "id": "String (UUID/ObjectId)",
        "userId": "String (Foreign key to User)",
        "title": "String",
        "templateId": "String",
        "personalDetails": "Object",
        "experiences": "Array<Object>",
        "education": "Array<Object>",
        "skills": "Array<String>",
        "projects": "Array<Object>",
        "certifications": "Array<Object>",
        "createdAt": "DateTime",
        "updatedAt": "DateTime"
      }
    }
  },
  "api_contracts": {
    "base_url": "http://localhost:5000/api",
    "endpoints": [
      {
        "path": "/health",
        "method": "GET",
        "description": "Health check status"
      },
      {
        "path": "/auth/config",
        "method": "GET",
        "description": "Fetch active database auth configuration"
      },
      {
        "path": "/auth/config",
        "method": "PUT",
        "description": "Update database auth configuration settings"
      },
      {
        "path": "/auth/register",
        "method": "POST",
        "description": "Register user with basic details (Name, Email, Phone, Password) and generate verification code"
      },
      {
        "path": "/auth/verify-code",
        "method": "POST",
        "description": "Verify 6-digit Email/Phone PIN to activate account"
      },
      {
        "path": "/auth/login-password",
        "method": "POST",
        "description": "Authenticate user via Phone/Email + Password"
      },
      {
        "path": "/auth/send-otp",
        "method": "POST",
        "description": "Generate and send 6-digit OTP code to Phone/Email"
      },
      {
        "path": "/auth/login-otp",
        "method": "POST",
        "description": "Authenticate user via verified OTP"
      },
      {
        "path": "/users/profile",
        "method": "GET / PUT",
        "description": "Fetch or update logged-in user profile"
      },
      {
        "path": "/users/change-password",
        "method": "POST",
        "description": "Change account password"
      },
      {
        "path": "/users/security-logs",
        "method": "GET",
        "description": "Retrieve account security audit log events"
      },
      {
        "path": "/ai/generate-summary",
        "method": "POST",
        "description": "AI professional summary generator"
      },
      {
        "path": "/ai/enhance-bullets",
        "method": "POST",
        "description": "AI action-verb bullet point enhancer"
      },
      {
        "path": "/ai/ats-score",
        "method": "POST",
        "description": "ATS compatibility score inspector"
      }
    ]
  }
}
