// Prisma Database Schema for AI Resume Builder
datasource db {
  provider = "sqlite" // Can be switched to postgresql or mongodb
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  ADMIN
}

enum VerificationType {
  EMAIL_VERIFY
  PHONE_OTP
}

model User {
  id                String         @id @default(uuid())
  fullName          String
  email             String         @unique
  phone             String         @unique
  passwordHash      String?
  isEmailVerified   Boolean        @default(false)
  isPhoneVerified   Boolean        @default(false)
  role              Role           @default(USER)
  lastLoginAt       DateTime?
  resumes           Resume[]
  securityLogs      SecurityLog[]
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
}

model AuthConfig {
  id                       String   @id @default("default_config")
  defaultOtpCode           String   @default("123456")
  requireEmailVerification Boolean  @default(true)
  requirePhoneOtp          Boolean  @default(false)
  allowPasswordAuth        Boolean  @default(true)
  allowOtpAuth             Boolean  @default(true)
  otpExpirySeconds         Int      @default(300)
  maxOtpAttempts           Int      @default(3)
  sessionDurationHours     Int      @default(24)
  updatedAt                DateTime @updatedAt
}

model VerificationToken {
  id        String           @id @default(uuid())
  target    String           // Email address or Phone number
  code      String           // 6-digit PIN code
  type      VerificationType
  expiresAt DateTime
  used      Boolean          @default(false)
  createdAt DateTime         @default(now())
}

model SecurityLog {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action    String   // REGISTER, LOGIN_PASSWORD, LOGIN_OTP, PASSWORD_CHANGE, CONFIG_UPDATE
  ipAddress String   @default("127.0.0.1")
  createdAt DateTime @default(now())
}

model Resume {
  id           String           @id @default(uuid())
  userId       String?
  user         User?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String           @default("Untitled Resume")
  templateId   String           @default("modern-minimal")
  fullName     String?
  email        String?
  phone        String?
  location     String?
  website      String?
  github       String?
  linkedin     String?
  summary      String?
  skills       String?          // JSON array string
  experiences  WorkExperience[]
  education    Education[]
  projects     Project[]
  certifications Certification[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
}

model WorkExperience {
  id          String   @id @default(uuid())
  resumeId    String
  resume      Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  company     String
  position    String
  startDate   String?
  endDate     String?
  current     Boolean  @default(false)
  description String?
}

model Education {
  id           String   @id @default(uuid())
  resumeId     String
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  institution  String
  degree       String
  fieldOfStudy String?
  startDate    String?
  endDate      String?
  grade        String?
}

model Project {
  id           String   @id @default(uuid())
  resumeId     String
  resume       Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  link         String?
  technologies String?
}

model Certification {
  id       String  @id @default(uuid())
  resumeId String
  resume   Resume  @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  name     String
  issuer   String?
  date     String?
}

model AILog {
  id           String   @id @default(uuid())
  resumeId     String?
  actionType   String   // SUMMARY_GENERATE, BULLET_ENHANCE, ATS_ANALYSIS
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
}
